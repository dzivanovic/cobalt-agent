+@requires_db
+def test_progress_is_monotonic_across_accepted_runs():
+    st = BarStore()
+    st.ensure_schema()
+    plan = _accepted_plan()
+    now = datetime(2026, 8, 29, 12, 30, tzinfo=UTC)
