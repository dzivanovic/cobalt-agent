+
+# --- shadow_compare --------------------------------------------------
+
+
+@pytest.mark.parametrize("value,expected", [("on", ShadowCompare.ON), ("off", ShadowCompare.OFF)])
+def test_shadow_compare_on_and_off(value, expected):
