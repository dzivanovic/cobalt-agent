+def test_retention_deletes_only_nights_older_than_the_window(wired, tmp_path):
+    directory = shadow_mod.SHADOW_DIR
+    directory.mkdir(parents=True, exist_ok=True)
+    for age in (0, 1, 29, 30, 31, 400):
