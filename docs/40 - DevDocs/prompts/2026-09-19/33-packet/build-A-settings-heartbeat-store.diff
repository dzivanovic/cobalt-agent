+    row = registry.get(key)
+    if row is None:
+        raise ArchiverSettingsError(
+            f"tunables.yaml: missing {key} — the archiver reads every one of "
+            f"its {len(ARCHIVER_TUNABLE_UNITS)} settings from config and has "
+            "no built-in default (L1, L10)."
