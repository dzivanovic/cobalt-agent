+            raise ArchiverSettingsError(f"archiver settings unavailable: {e}") from e
+
+    payload = {field: _value(registry, key) for key, field in _TOP_FIELDS.items()}
+    payload["repair"] = {
+        field: _value(registry, key) for key, field in _REPAIR_FIELDS.items()
+    }
