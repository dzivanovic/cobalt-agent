+    probe = archiver_freshness(
+        store=_FakeStore(_row(exit_code=1)), now=NOW, incidents=_reader()
+    )
+    assert probe.ok is False
+    assert probe.detail == base.detail
+    assert "last run FAILED" in probe.detail
