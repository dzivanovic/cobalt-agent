+    parts = [
+        p.MOVED_TABLES,
+        p.SEEDED_TABLES,
+        p.MODULE_TABLES,
+        p.CREATED_TABLES,
+        p.CREATED_VIEWS,
+        p.DECLARED_TABLES,
+    ]
+    names = [name for part in parts for name in part]
+    assert len(names) == len(set(names)) == len(PLACEMENT)
