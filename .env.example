# .env — NAMES ONLY. Copy to `.env` and fill in; `.env` is git-ignored
# and must be mode 0600. Nothing here is a value, and nothing here is a
# default: every consumer fails loud on a missing part rather than
# reaching for one (TRIAGE secrets law, CLAUDE.md).
#
# `.env` is the BOOTSTRAP TIER and only that — what has to be readable
# BEFORE the vault can be opened. Everything else lives in VaultManager
# under `COBALT_MASTER_KEY`, which is also what enrols a value in F19's
# literal guard.

# ---------------------------------------------------------------------
# The vault
# ---------------------------------------------------------------------
# The Fernet key for data/.cobalt_vault. Absent from every environment
# except the ones that need it — deliberately, and F19's literal half
# reports itself INACTIVE rather than pretending otherwise.
COBALT_MASTER_KEY=
# Old-tree alias for the same key.
VAULT_MASTER_KEY=

# DEV CHECKOUTS ONLY, and normally unset. There is one vault on this
# host; `cobalt.redact.secrets` resolves it relative to the checkout,
# which is right for ~/cobalt and wrong in a git worktree. Production
# does NOT set this — see cobalt/redact/secrets.py's VAULT_FILE_ENV.
# COBALT_VAULT_FILE=

# ---------------------------------------------------------------------
# Postgres — ONE SERVER, TWO CREDENTIALS (2026-09-09)
# ---------------------------------------------------------------------
# The address is shared: which login you use has nothing to do with
# where the server is.
POSTGRES_HOST=
POSTGRES_PORT=

# THE APP LOGIN — `cobalt_app`, used by every store, job and probe
# (`cobalt.db.Credential.APP` -> `db.connect()`). LOGIN NOINHERIT and
# non-superuser: it holds nothing until the factory's `SET ROLE`, so a
# connection that skipped the factory can read nothing at all. Minted by
# ops/cobalt_app_role_provision.py; the copy in the vault under
# COBALT_DB_PASSWORD is its F19 enrolment.
COBALT_DB_USER=
COBALT_DB_PASSWORD=

# THE BOOTSTRAP LOGIN — the docker superuser. docker-compose
# interpolates this pair for the container itself and the old tree reads
# it; `cobalt.db` uses it for MIGRATIONS AND BOOTSTRAP ONLY
# (`Credential.BOOTSTRAP` -> `db.connect_migration()`). There is NO
# fallback from COBALT_DB_* to these: a missing app credential is an
# error, never a quiet promotion to superuser.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Mattermost's own Postgres role (2026-09-05). Bootstrap tier for the
# same reason: Compose interpolates the DSN at container-create time.
MATTERMOST_DB_USER=
MATTERMOST_DB_PASSWORD=

# pgAdmin's login (docker-compose).
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Old tree (src/cobalt_agent) — left as-is under the strangler rule
# ---------------------------------------------------------------------
# The Obsidian vault the OLD tree writes into. The new core does not
# read this: it resolves the vault through `cobalt.vault`, whose
# production override is COBALT_VAULT_PATH, set per-process in the
# plists (NN#16).
OBSIDIAN_VAULT_PATH=
BRIEFING_INBOX_DIR=
LM_STUDIO_API_KEY=
NETWORK_NODES_CORTEX_IP=
