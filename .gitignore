.env
logs/
__pycache__/
.venv/
venv/
data/
# D6 documentation standard (CLAUDE.md): docs/ is the gitignored
# Obsidian playground vault root by default; these are the sanctioned,
# versioned carve-outs. Every new markdown artifact files into one of
# these — never at repo root, never in a new ad-hoc folder.
docs/*
!docs/00 - Project/
!docs/00 - Project/**
!docs/10 - Decisions/
!docs/10 - Decisions/**
!docs/20 - Assessment/
!docs/20 - Assessment/**
!docs/30 - Design/
!docs/30 - Design/**
!docs/40 - DevDocs/
!docs/40 - DevDocs/**
!docs/50 - Roles/
!docs/50 - Roles/**
!docs/90 - References/
!docs/90 - References/**
docs/90 - References/assets/
!docs/_archive/
!docs/_archive/**
# docs/60 - Agent Output/ (renamed 2026-08-31 from docs/0 - Inbox/) is
# deliberately NOT carved out here — it's the old scheduler's live
# briefing landing folder, not a documentation tier; stays fully
# gitignored via the docs/* rule above, same as before the rename.
configs/dev/aset.local.yaml
# GENERATED from the DEV vault's Rules.md by a dev prefill run (2026-09-04,
# S1-P3). The production twin, configs/cobalt/rules.yaml, IS committed —
# splitting them is what stops a dev run rewriting production config.
configs/dev/rules.generated.yaml
docs/Cobalt/
architecture_assessments/
logs.vscode/
cobalt_context.txt
cobalt_master_context.txt
*.egg-info/
.DS_Store

# RULING 7 (2026-09-04) — the cobalt_dev -> cobalt_brain migration dump.
# This directory sits inside the "!docs/00 - Project/**" carve-out above,
# so without this rule its contents are tracked. The dump is a
# --data-only pg_dump of vault_writes, whose before/after/unit_before/
# unit_after columns hold VERBATIM production note text: Dejan's daily
# notes, journal entries and trade cards. Committing it would put vault
# contents into git history, which CLAUDE.md forbids absolutely. The
# dump is the migration's ROLLBACK and it stays local, on disk, only.
docs/00 - Project/incident-2026-09-03/

# S1-P2 (2026-09-04) — database dumps never enter git, wherever they land.
# The incident-directory rule above was location-based: it protected one
# folder, so the same dump written one directory over was tracked again.
# These two rules are content-based and belong to the dump itself.
#
# The carve-out below is NOT optional: `*.sql` would otherwise swallow
# every NEW schema migration (src/cobalt/*/migrations/*.sql) the moment
# it is created. Already-tracked migrations would survive (git ignores
# only untracked files) — which is exactly what makes this failure
# silent, and why the negation ships in the same commit as the rule.
*.sql
bars-dump-*
!src/cobalt/*/migrations/*.sql
!src/cobalt_agent/db/*.sql
