<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobalt.prefill-drc</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- NN#16 dev/prod vault split (2026-08-31): configs/dev/vault.yaml's
             committed default now points at the DEV skeleton vault
             (~/dev-vault-cobalt) — this is PRODUCTION, so it overrides back
             to the real vault explicitly. See src/cobalt/vault.py. -->
        <key>COBALT_VAULT_PATH</key>
        <string>/Users/cobalt/Vault/Think</string>
        <!-- Defect 1 fix (2026-09-01): declares production intent so
             cobalt.vault.resolve_vault_path() refuses if this ever resolves
             to a non-Think root (stale process, wrong override, etc.)
             instead of silently writing into the wrong vault. -->
        <key>COBALT_ENV</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/cobalt/.local/bin/uv</string>
        <string>run</string>
        <string>prefill</string>
        <string>drc</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- Same standalone-launchd pattern as com.cobalt.archiver. Mon-Fri
         15:40 local (assumes system TZ = ET) — after the close, before
         Dejan sits down to write the DRC, so cards from the whole day
         (including any post-close fill updates) are already in it. A
         re-run (e.g. Dejan already drafted by hand) appends a fenced,
         idempotency-marked block rather than clobbering his draft.
         Root cause (2026-09-03): ProgramArguments used a bare "uv" —
         see com.cobalt.prefill-daily.plist's note. launchd's
         posix_spawn() does not reliably resolve a bare program name via
         the job's own EnvironmentVariables PATH the way a shell does;
         this job's own 09-02 15:40 run failed identically (exit 78
         EX_CONFIG, empty stdout+stderr). Fixed to the absolute path
         (matches `which uv` on this machine). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/cobalt/cobalt/logs/prefill-drc.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cobalt/cobalt/logs/prefill-drc.err</string>
</dict>
</plist>
