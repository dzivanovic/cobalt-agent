<dict>
    <key>Label</key>
    <string>com.cobalt.prefill-refresh</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- Same as com.cobalt.prefill-daily: this job writes his REAL daily
             note, so it names the production vault explicitly and declares
             production intent (RULING 7 / Charter §8.4). -->
        <key>COBALT_VAULT_PATH</key>
        <string>/Users/cobalt/Vault/Think</string>
        <key>COBALT_ENV</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <!-- ABSOLUTE PATH, deliberately: launchd posix_spawn()s
             ProgramArguments[0] and does not search the job's own PATH
             (the 2026-09-03 exit-78 silence; see com.cobalt.prefill-daily). -->
        <string>/Users/cobalt/.local/bin/uv</string>
        <string>run</string>
        <string>prefill</string>
        <string>refresh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- F4 (FINAL §4.2): EVERY 30 MIN, 05:45-15:45 ET, Mon-Fri. launchd has
         no "every N minutes inside a window", so the window is EXPANDED here
         into one entry per firing: 21 a weekday x 5 = 105 entries. The
         cadence and the window are the tunables rows
         `prefill.refresh_interval_min` (30) and `prefill.refresh_window`
         (05:45-15:45), which the registry's schedule reads; this array is
         Schedule.calendar_entries() and the suite compares the two entry for
         entry. Local time = ET (the same assumption as prefill-daily). -->
    <key>StartCalendarInterval</key>
