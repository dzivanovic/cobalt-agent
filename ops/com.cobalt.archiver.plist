<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobalt.archiver</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- RULING 7 (2026-09-04): the environment law. COBALT_ENV is the
             ONE switch for BOTH the database and the vault
             (src/cobalt/env.py): production -> cobalt_brain +
             /Users/cobalt/Vault/Think, dev -> cobalt_dev + the dev
             vault. Unset now raises at boot instead of resolving
             silently, so this key is not optional decoration — a job
             that loses it fails loud rather than writing live trading
             data into the dev database, which is exactly what happened
             before this ruling. -->
        <key>COBALT_ENV</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/cobalt/.local/bin/uv</string>
        <string>run</string>
        <string>archiver</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- launchd runs this fully detached from any interactive session by
         construction (it's not a foreground shell command at all) --
         confirmed safe against the 2026-08-27 kill (a session/tool-level
         background-task lifecycle limit, evidence in BACKLOG.md; not an
         OS memory/sleep/crash event). Mon-Fri only, 20:30 local (assumes system TZ = ET, same as the
         old tree's Mon-Fri 08:00 Morning Briefing job) -- no point
         re-archiving stale bars on days markets didn't move.
         Root cause fix (2026-09-03): ProgramArguments hardcoded
         /opt/homebrew/bin/uv, which does not exist on this machine (uv
         is a standalone install at ~/.local/bin/uv — see ops/README.md's
         "uv path discrepancy" note); this job was also NOT LOADED at
         all (`launchctl print` found no service), so the wrong path had
         never actually been exercised by launchd. Fixed to the absolute
         real path and installed in this same pass. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/cobalt/cobalt/logs/archiver.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cobalt/cobalt/logs/archiver.err</string>
</dict>
</plist>
