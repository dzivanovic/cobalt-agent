<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobalt.prefill-daily</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- NN#16 dev/prod vault split (2026-08-31): configs/dev/vault.yaml's
             committed default now points at the DEV skeleton vault
             (~/dev-vault-cobalt) — this is PRODUCTION, so it overrides back
             to the real vault explicitly. See src/cobalt/vault.py. -->
        <key>COBALT_VAULT_PATH</key>
        <string>/Users/cobalt/Vault/Think</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>uv</string>
        <string>run</string>
        <string>prefill</string>
        <string>daily</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- Same standalone-launchd pattern as com.cobalt.archiver — detached
         from any interactive session by construction, immune to the
         2026-08-27 session-lifecycle kill. Mon-Fri 05:15 local (assumes
         system TZ = ET, same as the archiver's 20:30 job) — before
         premarket so the market table/calendar/rules block are ready
         when Dejan sits down.
         ProgramArguments uses a bare "uv" (resolved via this plist's own
         EnvironmentVariables PATH, which includes ~/.local/bin) rather
         than a hardcoded /opt/homebrew/bin/uv — that path doesn't exist
         on this machine (see ops/README.md's note on com.cobalt.archiver/
         mainframe carrying the same bug); fixed here before this plist
         is ever installed, same fix as ops/start_aset.sh.
         SLICE 2.1 (2026-08-31): the entrypoint (`uv run prefill daily`)
         is unchanged, but its behavior is now fill-in-place inside
         Dejan's actual sections (never append a block below them) — see
         src/cobalt/prefill/daily.py and docs/40 - DevDocs. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/cobalt/cobalt/logs/prefill-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cobalt/cobalt/logs/prefill-daily.err</string>
</dict>
</plist>
