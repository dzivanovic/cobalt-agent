<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobalt.aset</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- RULING 7 (2026-09-04): the environment law. COBALT_ENV is the
             ONE switch for BOTH the database and the vault
             (src/cobalt/env.py): production -> cobalt_brain +
             /Users/cobalt/Vault/Think, dev -> cobalt_dev + the dev
             vault. Unset now raises at boot instead of resolving
             silently, so this key is not optional decoration — a job
             that loses it fails loud rather than writing live trading
             data into the dev database, which is exactly what happened
             before this ruling. -->
        <key>COBALT_ENV</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/cobalt/cobalt/ops/start_aset.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- Persistence fix (2026-08-31 incident): the ASET widget had no
         LaunchAgent at all — it was only ever started by hand
         (`uv run python -m cobalt.aset`, no supervision) and died
         silently at the Aug 29 10:35 reboot, unnoticed until the
         trading PC got connection-refused on :5010. RunAtLoad brings
         it up on login/boot; KeepAlive brings it back if it ever exits
         (crash, kill) — matches com.cobalt.archiver/prefill's "detached,
         supervised" posture, upgraded here to persistent since ASET is
         a live-market-hours tool, not a scheduled batch job. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/cobalt/cobalt/logs/aset.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cobalt/cobalt/logs/aset.err</string>
</dict>
</plist>
