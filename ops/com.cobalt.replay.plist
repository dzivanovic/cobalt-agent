<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobalt.replay</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/cobalt/.local/bin</string>
        <!-- Production, exactly as the prefill plists: the miss line lands
             in the real vault's DRC note, so the override is explicit. -->
        <key>COBALT_VAULT_PATH</key>
        <string>/Users/cobalt/Vault/Think</string>
        <key>COBALT_ENV</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/cobalt/.local/bin/uv</string>
        <string>run</string>
        <string>cobalt</string>
        <string>replay</string>
        <string>nightly</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cobalt/cobalt</string>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- S2-P4 R3: Mon-Fri 21:05 local (system TZ = ET) — after the
         market_reset pause and after the 20:30 archiver, whose tonight's
         run it requires. Its vault write therefore falls outside
         market_reset and before the 21:40 backup captures it. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/cobalt/cobalt/logs/replay.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cobalt/cobalt/logs/replay.err</string>
</dict>
</plist>
